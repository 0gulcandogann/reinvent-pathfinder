# Optional alternative to `python scripts/sync_catalog.py --login`.
# A registered attendee's AWS Events OAuth access token (never commit it).
AWS_EVENTS_ACCESS_TOKEN=
# Keep local demo data and mutation writes explicitly separated from live AWS.
PATHFINDER_DEMO_MODE=false
AWS_EVENTS_ENABLE_WRITES=false
AWS_EVENTS_EVENT_ID=reinvent2026
# Optional path for the local SQLite catalog (default: data/catalog.sqlite3).
PATHFINDER_CATALOG_DB=
